# Source-only dependency. Nothing is downloaded into a tracked repository path.
set(PORTAL_SAMPLE_LLAMA_VERSION "v0.8.0")
set(PORTAL_SAMPLE_LLAMA_COMMIT "8642541b255bfb5dc39cd351a178be09013a55d6")
set(PORTAL_SAMPLE_LLAMA_SHA256 "1688a167a8edd9499cdd0c19b8bd044f0fa184b466981977bbf2222d884953a4")
set(PORTAL_SAMPLE_LLAMA_URL "https://codeload.github.com/ggml-org/llama.cpp/tar.gz/${PORTAL_SAMPLE_LLAMA_COMMIT}")

if(DEFINED ENV{PORTAL_SAMPLE_LLM_CACHE} AND NOT "$ENV{PORTAL_SAMPLE_LLM_CACHE}" STREQUAL "")
    set(_llama_cache "$ENV{PORTAL_SAMPLE_LLM_CACHE}")
elseif(DEFINED ENV{XDG_CACHE_HOME} AND NOT "$ENV{XDG_CACHE_HOME}" STREQUAL "")
    set(_llama_cache "$ENV{XDG_CACHE_HOME}/portal-sample-llm")
elseif(WIN32 AND DEFINED ENV{LOCALAPPDATA})
    set(_llama_cache "$ENV{LOCALAPPDATA}/portal-sample-llm")
elseif(DEFINED ENV{HOME})
    set(_llama_cache "$ENV{HOME}/.cache/portal-sample-llm")
else()
    message(FATAL_ERROR "Set PORTAL_SAMPLE_LLM_CACHE to an external, writable dependency cache.")
endif()
get_filename_component(_llama_cache "${_llama_cache}" REALPATH)
get_filename_component(_sample_repo "${CMAKE_CURRENT_LIST_DIR}/../../.." REALPATH)
file(RELATIVE_PATH _cache_relative "${_sample_repo}" "${_llama_cache}")
if(NOT _cache_relative MATCHES "^\\.\\./" AND NOT IS_ABSOLUTE "${_cache_relative}")
    message(FATAL_ERROR "PORTAL_SAMPLE_LLM_CACHE must be outside the repository.")
endif()

file(MAKE_DIRECTORY "${_llama_cache}")
# Android ABIs and desktop/iOS configurations can fetch concurrently.
file(LOCK "${_llama_cache}/source.lock" GUARD FILE TIMEOUT 180)
set(_archive "${_llama_cache}/llama.cpp-${PORTAL_SAMPLE_LLAMA_COMMIT}.tar.gz")
if(EXISTS "${_archive}")
    file(SHA256 "${_archive}" _cached_hash)
    if(NOT _cached_hash STREQUAL PORTAL_SAMPLE_LLAMA_SHA256)
        file(REMOVE "${_archive}")
    endif()
endif()
if(NOT EXISTS "${_archive}")
    message(STATUS "Downloading llama.cpp ${PORTAL_SAMPLE_LLAMA_VERSION} pinned source (not model weights)")
    file(DOWNLOAD "${PORTAL_SAMPLE_LLAMA_URL}" "${_archive}"
        EXPECTED_HASH "SHA256=${PORTAL_SAMPLE_LLAMA_SHA256}"
        TLS_VERIFY ON SHOW_PROGRESS TIMEOUT 180 STATUS _download_status)
    list(GET _download_status 0 _download_code)
    if(NOT _download_code EQUAL 0)
        file(REMOVE "${_archive}")
        message(FATAL_ERROR "Unable to fetch checksum-verified llama.cpp source: ${_download_status}")
    endif()
endif()
set(PORTAL_SAMPLE_LLAMA_SOURCE "${_llama_cache}/llama.cpp-${PORTAL_SAMPLE_LLAMA_COMMIT}")
if(NOT EXISTS "${PORTAL_SAMPLE_LLAMA_SOURCE}/.portal-source-sha256")
    set(_extract "${_llama_cache}/extract-${PORTAL_SAMPLE_LLAMA_COMMIT}")
    file(REMOVE_RECURSE "${_extract}" "${PORTAL_SAMPLE_LLAMA_SOURCE}")
    file(MAKE_DIRECTORY "${_extract}")
    file(ARCHIVE_EXTRACT INPUT "${_archive}" DESTINATION "${_extract}")
    file(RENAME "${_extract}/llama.cpp-${PORTAL_SAMPLE_LLAMA_COMMIT}" "${PORTAL_SAMPLE_LLAMA_SOURCE}")
    file(WRITE "${PORTAL_SAMPLE_LLAMA_SOURCE}/.portal-source-sha256" "${PORTAL_SAMPLE_LLAMA_SHA256}\n")
    file(REMOVE_RECURSE "${_extract}")
endif()
file(LOCK "${_llama_cache}/source.lock" RELEASE)
